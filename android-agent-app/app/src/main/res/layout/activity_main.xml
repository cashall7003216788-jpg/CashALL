<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 1. WEBVIEW WITH PULL TO REFRESH -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- LOADING PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. NATIVE EMERGENCY LOUD ALARM CONTROL BAR (SHOWN WHEN BUZZER SOUNDS) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/alarmActiveCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/red_alarm"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 NEW LEAD ASSIGNED!"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loud buzzer &amp; vibration active"
                    android:textColor="#FEE2E2"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStopNativeAlarm"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Stop Buzzer"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="@color/black" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. MANDATORY PERMISSIONS & AUTO CALL RECORDING GATEKEEPER OVERLAY -->
    <ScrollView
        android:id="@+id/permissionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CashALL Field Agent"
                android:textColor="@color/yellow_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mandatory Setup &amp; Calling Permissions"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="24dp" />

            <!-- Info card explaining why all settings are mandatory -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Required Permissions (Mandatory)"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 Phone &amp; Call Logs\nEnables 1-tap customer calls and verifies exact call talk time."
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 24/7 Loud Alarm &amp; Siren\nSounds full-volume buzzer even when your phone is locked or on silent."
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Audio &amp; Media Storage\nDiscovers 2-way call recordings from your phone dialer for QA sync."
                        android:textColor="#E5E7EB"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷 Camera &amp; Inspection\nFor doorstep IMEI scanning, device photos, and payment UTR OCR."
                        android:textColor="#E5E7EB"
                        android:textSize="12sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Auto-Call Record Setting Button -->
            <Button
                android:id="@+id/btnAutoRecordSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🎙️ Turn ON Auto Call Recording in Phone"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="@color/yellow_primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to open Phone Settings ➔ Turn ON 'Auto-record calls' so all customer conversations are saved in HD."
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Grant All Permissions Button -->
            <Button
                android:id="@+id/btnGrantPermissions"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Grant All Mandatory Permissions"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#2563EB"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvPermissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All permissions must be granted to access the CashALL Agent Console."
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
